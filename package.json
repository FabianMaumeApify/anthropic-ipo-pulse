{
    "name": "anthropic-ipo-pulse",
    "version": "0.0.1",
    "type": "module",
    "description": "Daily and live sentiment pulse for the Anthropic IPO across X, LinkedIn, YouTube and stock news",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "apify-client": "^2.25.0",
        "apify-orchestrator": "0.9.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run"
    },
    "author": "Apify",
    "license": "MIT"
}
